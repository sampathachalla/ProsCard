{
  "expo": {
    "name": "ProsCard",
    "slug": "ProsCard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "proscard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    },
    "plugins": [
      [
        "expo-router",
        {
          "unstable_useServerRendering": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ProsCard uses the camera to scan QR codes on business cards."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ProsCard needs access to your photo library to upload profile, cover, and logo images."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
