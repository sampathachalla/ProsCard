NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
AUTH_RATE_LIMIT_MAX=20
MEDIA_CLEANUP_INTERVAL_SECONDS=900
LOG_LEVEL=info
LOG_SINK_URL=
LOG_SINK_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=proscard
DB_USER=proscard
DB_PASSWORD=change-me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
PASSWORD_RESET_REDIRECT_URL=http://localhost:8081/auth/reset-password
# For native builds, use proscard://auth/reset-password and add it to the Supabase redirect allow-list.
OCI_REGION=us-ashburn-1
OCI_NAMESPACE=your-namespace
OCI_BUCKET_NAME=your-bucket
OCI_TENANCY_OCID=your-tenancy-ocid
OCI_USER_OCID=your-user-ocid
OCI_FINGERPRINT=your-api-key-fingerprint
OCI_PRIVATE_KEY_PATH=./secrets/oci_private.pem
OCI_PRIVATE_KEY_PASSPHRASE=
OCI_DOWNLOAD_URL_EXPIRES_SECONDS=900
OCI_UPLOAD_URL_EXPIRES_SECONDS=900

# Business-card reading (OpenAI gpt-5.4-mini). Leave LLM_API empty to disable; photos are sent to OpenAI when enabled.
LLM_API=
LLM_TIMEOUT_MS=30000
SCANNER_RATE_LIMIT_MAX=20
