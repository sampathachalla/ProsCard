# ─── Backend switch ──────────────────────────────────────────────────────────
# Choose which backend the app talks to (missing or invalid values fall back to oci):
#   local  → Docker backend on this computer   (uses EXPO_PUBLIC_LOCAL_API_URL)
#   tunnel → this computer's backend via tunnel (uses EXPO_PUBLIC_TUNNEL_API_URL)
#   oci    → backend on the OCI server          (uses EXPO_PUBLIC_OCI_API_URL)
# After changing it, restart Expo with a cleared cache:  npx expo start --host lan --clear
EXPO_PUBLIC_BACKEND_TARGET=oci

# ─── Backend addresses ───────────────────────────────────────────────────────
# Use your computer's LAN IP for a physical device, not localhost.
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8050
EXPO_PUBLIC_TUNNEL_API_URL=https://your-current-api-tunnel.example
EXPO_PUBLIC_OCI_API_URL=http://<oci-instance-public-ip>:8050

# ─── Test mode (UI development) ──────────────────────────────────────────────
# true  → sign-up never registers: it signs in a local test user and opens onboarding
#         empty at step 1 every time. Login, onboarding, cards, contacts and profile
#         stay on this device; no backend calls are made. A "Test mode" badge shows.
# false → normal app talking to the backend chosen above.
# After changing it, restart Expo with a cleared cache:  npx expo start --clear
EXPO_PUBLIC_AUTH_TEST_MODE=false

# Public HTTPS origin for QR codes and Preview in the browser (must serve /share/<slug>).
# Leave empty: local/tunnel use the API origin; OCI API IPs auto-map to https://<ip>.nip.io
# Example: EXPO_PUBLIC_WEB_URL=https://150.136.12.178.nip.io
EXPO_PUBLIC_WEB_URL=

# Brandfetch Logo API client ID (https://brandfetch.com/developers)
EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=
