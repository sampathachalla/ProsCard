# Backend URLs. Pick which one is used with USE_OCI_BACKEND in services/api/config.ts.
# Use your computer's LAN IP for a physical device, not localhost.
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8050
EXPO_PUBLIC_OCI_API_URL=http://<oci-instance-public-ip>:8050

# Explicitly enable local fixture mode only for isolated UI development.
EXPO_PUBLIC_AUTH_TEST_MODE=false
