# ─── Backend switch ──────────────────────────────────────────────────────────
# Choose which backend the app talks to (missing or invalid values fall back to oci):
#   local  → Docker backend on this computer   (uses EXPO_PUBLIC_LOCAL_API_URL)
#   tunnel → this computer's backend via tunnel (uses EXPO_PUBLIC_TUNNEL_API_URL)
#   oci    → backend on the OCI server          (uses EXPO_PUBLIC_OCI_API_URL)
# After changing it, restart Expo with a cleared cache:  npx expo start --host lan --clear
EXPO_PUBLIC_BACKEND_TARGET=oci

# ─── Backend addresses ───────────────────────────────────────────────────────
# Use your computer's LAN IP for a physical device, not localhost.
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8050
EXPO_PUBLIC_TUNNEL_API_URL=https://your-current-api-tunnel.example
EXPO_PUBLIC_OCI_API_URL=http://<oci-instance-public-ip>:8050

# Explicitly enable local fixture mode only for isolated UI development.
EXPO_PUBLIC_AUTH_TEST_MODE=false

# Public address put in QR codes / share links (the API serves the share page at /share/<slug>).
# Leave empty to use the backend address chosen by EXPO_PUBLIC_BACKEND_TARGET; set it once you have a domain.
EXPO_PUBLIC_WEB_URL=
