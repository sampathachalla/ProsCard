{
  "expo": {
    "name": "Pros Card",
    "slug": "ProsCard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "proscard",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindpros.proscard",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mindpros.proscard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/mindpros-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ProsCard uses the camera to scan business cards and ProsCard QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ProsCard needs access to your photo library to upload profile images and business-card photos."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "ProsCard uses the camera to scan business cards and ProsCard QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8f1f8353-f1c7-4cde-9268-e88e954c727e"
      }
    },
    "owner": "sampath2001",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f1f8353-f1c7-4cde-9268-e88e954c727e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
