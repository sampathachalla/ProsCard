{
  "expo": {
    "name": "VC Pros",
    "slug": "ProsCard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "vcpros",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindpros.proscard",
      "appleTeamId": "64XX38YG83",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mindpros.proscard",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/vcpros-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#020617"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "VC Pros uses the camera to scan business cards and VC Pros QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VC Pros needs access to your photo library to upload profile images and business-card photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "VC Pros needs access to Photos so you can select images for your cards.",
          "savePhotosPermission": "VC Pros saves your card QR code to Photos when you request it.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "VC Pros uses the camera to scan business cards and VC Pros QR codes."
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "VCProsCardWidget",
              "displayName": "VC Pros QR Card",
              "description": "Keep your VC Pros card QR code ready on your Home Screen and Lock Screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular"
                ],
                "contentMarginsDisabled": true
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal"
              }
            }
          ]
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8f1f8353-f1c7-4cde-9268-e88e954c727e"
      }
    },
    "owner": "sampath2001",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8f1f8353-f1c7-4cde-9268-e88e954c727e",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
